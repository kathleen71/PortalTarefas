@model List<Tarefa>

@{
    ViewData["Title"] = "Minhas tarefas";
}

<h2>Minhas tarefas</h2>

<p>Acompanhe as tarefas cadastradas no sistema.</p>

<a asp-action="Create" class="botao">+ Nova tarefa</a>

@if (Model.Count == 0)
{
    <p>Nenhuma tarefa cadastrada até o momento.</p>
}
else
{
    <table style="width:100%; margin-top:20px; border-collapse:collapse;">
        <thead>
            <tr>
                <th style="text-align:left; padding:10px;">Título</th>
                <th style="text-align:left; padding:10px;">Descrição</th>
                <th style="text-align:left; padding:10px;">Situação</th>
                <th style="padding:10px;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tarefa in Model)
            {
                <tr>
                    <td style="padding:10px;">@tarefa.Titulo</td>
                    <td style="padding:10px;">@tarefa.Descricao</td>
                    <td style="padding:10px;">@tarefa.Situacao</td>
                    <td style="padding:10px;">
                        <a asp-action="Details" asp-route-id="@tarefa.Id">Detalhes</a>
                        |
                        <a asp-action="Edit" asp-route-id="@tarefa.Id">Editar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
